--- !u!114 &1253293799
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1253293798}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 819d7259f54bc7b4c99bd8cb9d9e95f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcPortrait: {fileID: 4710025171527632521, guid: c0cc1beeb1319f946a48df8ee26c3a89, type: 3}
  playerPortrait: {fileID: -2876489889387380324, guid: 6bf79f465af52894d8c016e07b1b974f, type: 3}
  dialogue:
  - speaker: 0
    text: "\u041E, \u0413\u0430\u0437\u0430\u043D! \u0413\u0434\u0435 \u0442\u044B
      \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u043B?
      \u0412\u0441\u0435\u0445 \u0443\u0431\u0438\u043B\u0438, \u0430 \u0442\u044B
      \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0432\u0441\u0435\u0445
      \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C... "
  - speaker: 1
    text: "\u0427\u0422\u041E??? \u0422\u0415\u0422\u042E \u041C\u041E\u0422\u042E
      \u0422\u041E\u0416\u0415 \u0423\u0411\u0418\u041B\u0418?"
  - speaker: 0
    text: "\u0414\u0430... \u042F \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
      \u0434\u0430\u0442\u044C \u043E\u0442\u043F\u043E\u0440, \u043D\u043E \u043C\u0435\u043D\u044F
      \u0424\u0438\u043D\u0438\u043A \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B
      \u0432 \u043E\u0431\u0440\u044B\u0432!!!"
  - speaker: 1
    text: "\u042F \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u043C\u043D\u044E...
      \u042F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u0437\u0430
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435\u0439 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      - \u0432\u0438\u0434\u0438\u043C\u043E \u0443\u0441\u043D\u0443\u043B, \u043A\u043E\u0433\u0434\u0430
      \u0443\u0448\u0435\u043B \u0437\u0430 \u0445\u043B\u0435\u0431\u043E\u043C
      \U0001F920"
  - speaker: 0
    text: "\u042F \u043D\u0430\u0448\u043B\u0430 \u043A\u0440\u044E\u043A \u0442\u0443\u0442.
      \u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0439,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u0435\u0435.
      \u042F \u043E\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C \u043E\u0442
      \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0443\u0441\u044C"
  promptText: "[ E ] \u0413\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
  fontSize: 40
  promptColor: {r: 0, g: 0.38262594, b: 1, a: 1}
  promptPosY: 0.85
